# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# Backtesting needs NONE of these — klines are free and public.

# --- Binance (key with TRADE enabled, WITHDRAWAL DISABLED, IP-whitelisted) ---
LONGBOT_BINANCE_API_KEY=
LONGBOT_BINANCE_API_SECRET=
LONGBOT_USE_TESTNET=true

# --- trading ---
LONGBOT_QUOTE_CURRENCY=USDT
LONGBOT_TIMEFRAME=1h
LONGBOT_CAPITAL=1000
LONGBOT_AUTOTRADE=false        # false = bot suggests, you place the trade

# --- risk governor (hard kill-switch) ---
LONGBOT_MAX_DAILY_LOSS_PCT=0.05
LONGBOT_MAX_DRAWDOWN_PCT=0.20
LONGBOT_MAX_CONSECUTIVE_LOSSES=4

# --- notifications ---
LONGBOT_TELEGRAM_BOT_TOKEN=
LONGBOT_TELEGRAM_CHAT_ID=

# --- Coroner (post-mortem LLM, reports to you only) ---
LONGBOT_GEMINI_API_KEY=
LONGBOT_CORONER_MODEL=gemini-1.5-flash
LONGBOT_ANTHROPIC_API_KEY=
